#!/bin/sh
#
# Switch the active display output by swapping /boot/loader.conf
# variants.  Two pre-saved configs live at:
#
#   /boot/loader.conf.hdmi_working  — rk_drm via HDMI (hw.rk_drm.output=1)
#   /boot/loader.conf.dp_working    — rk_drm via USB-C DP (hw.rk_drm.output=2)
#
# Usage:
#   switch_output hdmi [reboot]
#   switch_output dp   [reboot]
#
# Without `reboot`, prints what changed and reminds you to reboot
# manually.  With `reboot`, reboots immediately.

set -eu

target="${1:-}"
maybe_reboot="${2:-}"

case "$target" in
hdmi|HDMI)	src="/boot/loader.conf.hdmi_working" ;;
dp|DP)		src="/boot/loader.conf.dp_working" ;;
"")
	echo "usage: $0 hdmi|dp [reboot]" >&2
	exit 1
	;;
*)
	echo "$0: unknown target '$target' (expected hdmi or dp)" >&2
	exit 1
	;;
esac

if [ ! -f "$src" ]; then
	echo "$0: missing config '$src'" >&2
	exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
	echo "$0: must run as root" >&2
	exit 1
fi

current_output="$(grep -E '^hw\.rk_drm\.output=' /boot/loader.conf || echo '?')"
new_output="$(grep -E '^hw\.rk_drm\.output=' "$src" || echo '?')"

cp "$src" /boot/loader.conf
echo "switched to $target"
echo "  was: $current_output"
echo "  now: $new_output"

case "$maybe_reboot" in
reboot|REBOOT)
	echo "rebooting…"
	exec /sbin/reboot
	;;
"")
	echo
	echo "reboot to activate, e.g.: sudo reboot"
	;;
*)
	echo "$0: trailing arg '$maybe_reboot' ignored (expected 'reboot')" >&2
	;;
esac
