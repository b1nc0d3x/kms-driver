#!/bin/sh
# PROVIDE: igen_attach
# REQUIRE: FILESYSTEMS
# BEFORE:  LOGIN
# KEYWORD: nojail
#
# fbsdx86 boot-time attach for the igen KMS driver.
#
# Purpose: the FreeBSD kernel probes vgapci0 as the default driver for
# Intel HD Graphics, so at cold boot igen has to displace it via
# detach + rescan.  We do it here (rc.d BEFORE LOGIN) instead of
# /boot/loader.conf because loader-time module load wedges the box
# on this Kabylake platform (verified 2026-07-17, requires physical
# recovery).
#
# Running BEFORE LOGIN means sddm's rc.d start finds /dev/dri/card0
# already registered, so sddm_enable="YES" works normally.
#
# Also fires the tested-safe manual bring-up path
# (dev.igen.0.re.gen9_full_bringup_now=1) which lights DDI_B + PIPE_A
# on soft reboot when the previous kernel's shutdown left DDI_B
# disabled.  No-op on cold boot where firmware lit the pipe.
#
# Finally, refreshes XDG_RUNTIME_DIR ownership for admin — /var/run
# is tmpfs so /var/run/xdg/admin loses admin:admin every boot, and
# sddm's autologin PAM refuses the session without it.
#
# Install:
#   sudo install -m 555 conf/rc.d/igen_attach /etc/rc.d/igen_attach
#   sudo sysrc igen_attach_enable=YES

. /etc/rc.subr

name=igen_attach
rcvar=igen_attach_enable

start_cmd=igen_attach_start
stop_cmd=":"

igen_attach_start()
{
    devctl detach vgapci0
    kldload /boot/modules/kms.ko
    kldload /boot/modules/igen.ko
    devctl rescan pci0
    sysctl dev.igen.0.re.gen9_full_bringup_now=1
    mkdir -p /var/run/xdg/admin
    chown admin:admin /var/run/xdg/admin
    chmod 700 /var/run/xdg/admin
}

load_rc_config $name
: ${igen_attach_enable:="NO"}
run_rc_command "$1"
